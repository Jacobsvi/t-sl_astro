---
import kamera from "../images/kamera_img_index.jpg";
import Lys from "../images/Lys_img_index.png";
import Lyd from "../images/Lyd_img_index.png";
import kit from "../images/Kit_img_index.png";
import Podcast from "../images/Podcast.png";
import Photo from "../images/Photo.png";
import Eyetracking from "../images/Eyetracking.png";

import KnapSecondary from "../components/Knap_secondary.astro";
import UdstyrCardIndex from "../components/Udstyr_card_index.astro";
import StudioCardIndex from "../components/Studio_card_index.astro";
import OverskriftBookUdstyr from "../components/Overskrift_BookUdstyr.astro";
import Forside from "../components/Forside.astro";

import Layout from "../layouts/layout.astro";

/* API-INDSTILLINGER */
const apiurl =
  "https://uyxpjeeivebwemzealvq.supabase.co/rest/v1/";

const equipmentTableName = "equipment";
const staffTableName = "staff";
const eventsTableName = "events";
const studiocardsTableName = "studiocards";

const key =
  "sb_publishable_2crJgmsXwxJPMYeBofiiEQ_Yrl1mHLo";

const options = {
  headers: {
    apikey: key,
  },
};

/* HENT STUDIOCARDS */
const studiocardsResponse = await fetch(
  apiurl + studiocardsTableName,
  options
);

const studiocardsData = await studiocardsResponse.json();

console.log("studiocardsData", studiocardsData);

/* HENT EVENTS */
const eventsResponse = await fetch(
  apiurl + eventsTableName,
  options
);

const eventsData = await eventsResponse.json();

console.log("eventsData", eventsData);

/* HENT UDSTYR */
const equipmentResponse = await fetch(
  apiurl + equipmentTableName,
  options
);

const equipmentData = await equipmentResponse.json();

console.log("equipmentData", equipmentData);

/* HENT MEDARBEJDERE */
const staffResponse = await fetch(
  apiurl + staffTableName,
  options
);

const staffData = await staffResponse.json();

console.log("staffData", staffData);
---

<Layout>
  <!-- FORSIDENS INTRO -->
  <Forside />

  <h2>Deployment</h2>

  <!-- BOOK UDSTYR -->
  <section class="udstyr-sektion">
    <OverskriftBookUdstyr>
      Book Udstyr
    </OverskriftBookUdstyr>

    <div class="book_udstyr_flex">
      <!-- KAMERA -->
      <UdstyrCardIndex>
        <img
          slot="billede"
          src={kamera.src}
          alt="Kamera"
        />

        <div slot="tekst">
          <h2>Kamera</h2>

          <p>
            Har du brug for en masse udstyr til et større projekt,
            så har vi helt sikkert en pakke der passer til dig.
            Gå på opdagelse og find et kit der passer til dit projekt.
          </p>
        </div>
      </UdstyrCardIndex>

      <!-- LYS -->
      <UdstyrCardIndex>
        <img
          slot="billede"
          src={Lys.src}
          alt="Lys"
        />

        <div slot="tekst">
          <h2>Lys</h2>

          <p>
            Har du brug for en masse udstyr til et større projekt,
            så har vi helt sikkert en pakke der passer til dig.
            Gå på opdagelse og find et kit der passer til dit projekt.
          </p>
        </div>
      </UdstyrCardIndex>

      <!-- LYD -->
      <UdstyrCardIndex>
        <img
          slot="billede"
          src={Lyd.src}
          alt="Lyd"
        />

        <div slot="tekst">
          <h2>Lyd</h2>

          <p>
            Har du brug for en masse udstyr til et større projekt,
            så har vi helt sikkert en pakke der passer til dig.
            Gå på opdagelse og find et kit der passer til dit projekt.
          </p>
        </div>
      </UdstyrCardIndex>

      <!-- KIT -->
      <UdstyrCardIndex>
        <img
          slot="billede"
          src={kit.src}
          alt="Kit med udstyr"
        />

        <div slot="tekst">
          <h2>KIT</h2>

          <p>
            Har du brug for en masse udstyr til et større projekt,
            så har vi helt sikkert en pakke der passer til dig.
            Gå på opdagelse og find et kit der passer til dit projekt.
          </p>
        </div>
      </UdstyrCardIndex>
    </div>
  </section>

  <!-- BOOK STUDIO -->
  <section class="studio-sektion">
    <OverskriftBookUdstyr hoejre>
      Book Studio
    </OverskriftBookUdstyr>

    <div class="book_studio_flex">
      <!-- PODCAST -->
      <StudioCardIndex>
        <img
          slot="billede"
          src={Podcast.src}
          alt="Podcast"
        />

        <div slot="tekst">
          <h2>Podcast</h2>

          <p>
            Har du brug for en masse udstyr til et større projekt,
            så har vi helt sikkert en pakke der passer til dig.
            Gå på opdagelse og find et kit der passer til dit projekt.
          </p>
        </div>
      </StudioCardIndex>

      <!-- PHOTO -->
      <StudioCardIndex>
        <img
          slot="billede"
          src={Photo.src}
          alt="Fotostudie"
        />

        <div slot="tekst">
          <h2>Photo</h2>

          <p>
            Har du brug for en masse udstyr til et større projekt,
            så har vi helt sikkert en pakke der passer til dig.
            Gå på opdagelse og find et kit der passer til dit projekt.
          </p>
        </div>
      </StudioCardIndex>

      <!-- EYE TRACKING -->
      <StudioCardIndex>
        <img
          slot="billede"
          src={Eyetracking.src}
          alt="Eye Tracking"
        />

        <div slot="tekst">
          <h2>Eye Tracking</h2>

          <p>
            Har du brug for en masse udstyr til et større projekt,
            så har vi helt sikkert en pakke der passer til dig.
            Gå på opdagelse og find et kit der passer til dit projekt.
          </p>
        </div>
      </StudioCardIndex>
    </div>
  </section>
</Layout>

<style>
  /* SEKTIONERNES PLACERING OG AFSTAND */
  .udstyr-sektion,
  .studio-sektion {
    position: relative;
    isolation: isolate;
    margin-top: 64px;
  }

  /* FÆLLES LAYOUT FOR BEGGE GRUPPER AF CARDS */
  .book_udstyr_flex,
  .book_studio_flex {
    display: flex;
    gap: 30px;
    justify-content: center;

    /* Cards foran overskriftsbaggrunden */
    position: relative;
    z-index: 1;

    /* Overlap med overskriftsbaggrunden */
    margin-top: -40px;
    padding-inline: 28px;
  }

  /* DESKTOP */
  @media (min-width: 1024px) {
    .book_udstyr_flex,
    .book_studio_flex {
      margin-top: -70px;
    }
  }

  /* MOBIL */
  @media (max-width: 1023px) {
    .book_udstyr_flex,
    .book_studio_flex {
      display: grid;
      gap: 12px;
      padding-inline: 12px;
    }

    /* Udstyr: to cards pr. række */
    .book_udstyr_flex {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Studio: ét card pr. række */
    .book_studio_flex {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 24px;
    }
  }
</style>