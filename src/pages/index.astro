---
import kamera from "../images/kamera_img_index.jpg";
import Lys from "../images/Lys_img_index.png";
import Lyd from "../images/Lyd_img_index.png";
import kit from "../images/KIT_img_index.png";
import Podcast from "../images/Podcast.png";
import Photo from "../images/Photo.png";
import Labs7 from "../images/Labs_7.webp";
import AltOmWorkshop from "../images/Alt_om.png";
import EyeTrackingWorkshop from "../images/Eye tracking.png";
import KameraWorkshop from "../images/Kamera.png";

import TeamCard from "../components/Team_card.astro";
import KnapPrimary from "../components/Knap_primary.astro";
import UdstyrCardIndex from "../components/Udstyr_card_index.astro";
import StudioCardIndex from "../components/Studio_card_index.astro";
import OverskriftBookUdstyr from "../components/Overskrift_BookUdstyr.astro";
import Forside from "../components/Forside.astro";
import Layout from "../layouts/layout.astro";

/* INDHOLD TIL UDSTYRSCARDS */
const udstyrCards = [
  {
    navn: "Kamera",
    billede: kamera,
    alt: "Kamera",
  },
  {
    navn: "Lys",
    billede: Lys,
    alt: "Lys",
  },
  {
    navn: "Lyd",
    billede: Lyd,
    alt: "Lyd",
  },
  {
    navn: "KIT",
    billede: kit,
    alt: "Kit med udstyr",
  },
];

/*
  LINKS TIL STUDIOKNAPPER

  Ret href nedenfor, hvis du har en anden bookingside.
*/
const studioCards = [
  {
    navn: "Podcast",
    billede: Podcast,
    alt: "Podcast",
    href: "/help/",
  },
  {
    navn: "Photo",
    billede: Photo,
    alt: "Fotostudie",
    href: "/help/",
  },
  {
    navn: "Eye Tracking",
    billede: Labs7,
    alt: "Eye Tracking",
    href: "/help/",
  },
];

/* FÆLLES CARD-TEKST */
const cardTekst =
  "Har du brug for en masse udstyr til et større projekt, " +
  "så har vi helt sikkert en pakke der passer til dig. " +
  "Gå på opdagelse og find et kit der passer til dit projekt.";

/* INDHOLD TIL WORKSHOPS */
const workshopCards = [
  {
    titel: "Alt om labbet",
    billede: AltOmWorkshop,
    tekst: "Lær vores faciliteter og udstyr at kende.",
  },
  {
    titel: "Alt om eye tracking",
    billede: EyeTrackingWorkshop,
    tekst: "Lær udstyret at kende.",
  },
  {
    titel: "Alt om kameraer",
    billede: KameraWorkshop,
    tekst: "Lær vores udstyr at kende.",
  },
];

/* API-INDSTILLINGER */
const apiurl =
  "https://uyxpjeeivebwemzealvq.supabase.co/rest/v1/";

const equipmentTableName = "equipment";
const staffTableName = "staff";
const eventsTableName = "events";
const studiocardsTableName = "studiocards";

const key =
  "sb_publishable_2crJgmsXwxJPMYeBofiiEQ_Yrl1mHLo";

const options = {
  headers: {
    apikey: key,
  },
};

/* HENT STUDIOCARDS */
const studiocardsResponse = await fetch(
  apiurl + studiocardsTableName,
  options
);

const studiocardsData = await studiocardsResponse.json();

console.log("studiocardsData", studiocardsData);

/* HENT EVENTS */
const eventsResponse = await fetch(
  apiurl + eventsTableName,
  options
);

const eventsData = await eventsResponse.json();

console.log("eventsData", eventsData);

/* HENT UDSTYR */
const equipmentResponse = await fetch(
  apiurl + equipmentTableName,
  options
);

const equipmentData = await equipmentResponse.json();

console.log("equipmentData", equipmentData);

/* HENT MEDARBEJDERE */
const staffResponse = await fetch(
  apiurl + staffTableName,
  options
);

type Medarbejder = {
  img: string | null;
  firstname: string;
  lastname: string;
  title: string;
  Speciale?: string | null;
  phone: string | null;
  email: string | null;
};

if (!staffResponse.ok) {
  const errorText = await staffResponse.text();

  console.error(
    "Supabase-fejl:",
    staffResponse.status,
    errorText
  );

  throw new Error(
    `Kunne ikke hente medarbejdere: ${staffResponse.status}`
  );
}

const staffData: Medarbejder[] =
  await staffResponse.json();

console.log("staffData", staffData);
---

<Layout>
  <div class="index-sektioner">
    <!-- FORSIDENS INTRO -->
    <Forside />

    <!-- STUDERENDES PROJEKTER -->
    <section
      class="projekter"
      aria-labelledby="projekter-titel"
    >
      <div class="projekter-indhold">
        <div class="projekter-tekst">
          <h2 id="projekter-titel">
            Se de studerendes projekter
          </h2>

          <p>
            Oplev nye idéer folde sig ud i Tech &amp; Story Lab
          </p>

          <p>
            Book udstyr helt gratis og se
            <br />
            dine ideer blive til virkelighed
          </p>

          <KnapPrimary href="/inspiration/" compact>
            Se mere
          </KnapPrimary>
        </div>

        <div class="projekter-billeder">
          <video
            class="projekt-video"
            autoplay
            muted
            loop
            playsinline
            controls
          >
            <source
              src="/fotostudie.mp4"
              type="video/mp4"
            />
          </video>

          <img
            class="projekt-billede"
            src={Labs7.src}
            alt="Studerendes arbejde i Tech & Story Lab"
          />
        </div>
      </div>
    </section>

    <!-- BOOK UDSTYR -->
    <section class="udstyr-sektion">
      <OverskriftBookUdstyr>
        Book Udstyr
      </OverskriftBookUdstyr>

      <div class="book_udstyr_flex">
        {
          udstyrCards.map((card) => (
            <UdstyrCardIndex>
              <img
                slot="billede"
                src={card.billede.src}
                alt={card.alt}
              />

              <div slot="tekst">
                <h2>{card.navn}</h2>
                <p>{cardTekst}</p>
              </div>
            </UdstyrCardIndex>
          ))
        }
      </div>
    </section>

    <!-- BOOK STUDIO -->
    <section class="studio-sektion">
      <OverskriftBookUdstyr hoejre>
        Book Studio
      </OverskriftBookUdstyr>

      <div class="book_studio_flex">
        {
          studioCards.map((card) => (
            <StudioCardIndex href={card.href}>
              <img
                slot="billede"
                src={card.billede.src}
                alt={card.alt}
              />

              <div slot="tekst">
                <h2>{card.navn}</h2>
                <p>{cardTekst}</p>
              </div>
            </StudioCardIndex>
          ))
        }
      </div>
    </section>

    <!-- EVENTS OG WORKSHOPS -->
    <section
      class="workshops"
      aria-labelledby="workshops-titel"
    >
      <div class="workshops-indhold">
        <h2 id="workshops-titel">
          Events &amp; Workshops
        </h2>

        <p class="workshops-intro">
          Tilmeld dig vores events og workshops og kom godt
          fra start. Du får en masse information om vores
          faciliteter og udstyr, så du er klædt rigtigt på
          til dine kommende projekter.
        </p>

        <div class="workshops-grid">
          {
            workshopCards.map((workshop) => (
              <article class="workshop-card">
                <div class="workshop-billede">
                  <img
                    src={workshop.billede.src}
                    alt=""
                  />

                  <div class="workshop-tekst">
                    <h3>{workshop.titel}</h3>

                    <p class="workshop-underoverskrift">
                      Introduktion
                    </p>

                    <p class="workshop-broedtekst">
                      {workshop.tekst}
                    </p>
                  </div>
                </div>

                <a
                  class="workshop-link"
                  href="/eventsandworkshops/"
                >
                  Book Workshop
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TEAM -->
    <section
      class="team-sektion"
      aria-labelledby="team-titel"
    >
      <h2 id="team-titel">Mød vores team</h2>

      <div class="team-grid">
        {
          staffData.map((person) => (
            <TeamCard
              billede={person.img}
              navn={`${person.firstname} ${person.lastname}`}
              titel={person.title}
              speciale={person.Speciale ?? ""}
              telefon={person.phone}
              email={person.email}
            />
          ))
        }
      </div>
    </section>
  </div>
</Layout>

<style>
  /* SEKTIONERNES PLACERING OG AFSTAND */
  .index-sektioner {
    display: grid;
    gap: 76px;
  }

  .udstyr-sektion,
  .studio-sektion {
    position: relative;
    isolation: isolate;
  }

  /* FÆLLES LAYOUT FOR CARDS */
  .book_udstyr_flex,
  .book_studio_flex {
    display: flex;
    gap: 30px;
    justify-content: center;

    position: relative;
    z-index: 1;

    margin-top: -40px;
    padding-inline: 28px;
  }

  /* PROJEKTER */
  .projekter {
    background-color: white;

    background-image: repeating-linear-gradient(
      125deg,
      #ff8d9d 0px,
      #ff8d9d 260px,
      rgb(255 141 157 / 80%) 260px,
      rgb(255 141 157 / 80%) 520px
    );

    color: white;
  }

  .projekter-indhold {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 32px;

    box-sizing: border-box;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding: 40px 32px;
  }

  .projekter-tekst h2 {
    font: var(--h1-oso-serif);
    margin-bottom: 48px;
  }

  .projekter-tekst p {
    font: var(--broedtekst-stor-oso-sans);
    font-weight: 600;
    margin-bottom: 28px;
  }

  .projekter-billeder {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));

    aspect-ratio: 3 / 2;
    min-width: 0;
  }

  .projekt-video,
  .projekt-billede {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;

    object-fit: cover;
    border: 4px solid var(--color-deep-plum);
    border-radius: 16px;
    position: relative;
  }

  .projekt-video {
    grid-column: 2 / 5;
    grid-row: 1 / 3;
    z-index: 2;

    transform: translate(20px, -20px);
    background-color: var(--color-deep-plum);
  }

  .projekt-billede {
    grid-column: 1 / 4;
    grid-row: 2 / 4;
    z-index: 1;

    transform: translate(-20px, 20px);
  }

  /* WORKSHOPS */
  .workshops {
    background-color: white;

    background-image: repeating-linear-gradient(
      55deg,
      #ff8d9d 0px,
      #ff8d9d 260px,
      rgb(255 141 157 / 80%) 260px,
      rgb(255 141 157 / 80%) 520px
    );

    color: white;
  }

  .workshops-indhold {
    box-sizing: border-box;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding: 48px 32px;
  }

  .workshops-indhold > h2 {
    font: var(--h1-oso-serif);
    margin: 0 0 32px;
  }

  .workshops-intro {
    font: var(--broedtekst-stor-oso-sans);
    font-weight: 600;
    margin: 0 0 48px;
  }

  .workshops-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .workshop-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;

    min-width: 0;
    padding: 24px;

    background-color: rgb(109 0 62 / 65%);
    border: 1px solid var(--color-deep-plum);
    border-radius: 12px;

    box-shadow: 4px 6px 4px rgb(0 0 0 / 20%);
    text-align: center;
  }

  .workshop-billede {
    position: relative;
    isolation: isolate;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto;

    width: 100%;
    max-width: 240px;
    min-height: 240px;

    aspect-ratio: auto;
    overflow: hidden;
  }

  .workshop-billede img,
  .workshop-tekst {
    grid-area: 1 / 1;
  }

  .workshop-billede img {
    position: absolute;
    inset: 0;
    z-index: 0;

    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: blur(4px);
  }

  .workshop-tekst {
    position: relative;
    z-index: 2;

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;

    min-width: 0;
    padding: 12px;

    color: var(--color-pure-white);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .workshop-tekst h3 {
    font: var(--h1-oso-serif);
    margin: 0;
  }

  .workshop-underoverskrift {
    font: var(--h2-oso-sans);
    margin: 0;
  }

  .workshop-broedtekst {
    font: var(--broedtekst-lille-oso-sans);
    margin: 0;
  }

  .workshop-link {
    display: inline-block;
    margin-top: auto;
    padding: 8px 12px;

    font: var(--knap-oso-serif);
    color: var(--color-pure-white);
    background-color: var(--color-orange);

    border: 2px solid var(--color-pure-white);
    outline: 2px solid var(--color-orange);
    border-radius: 10px;

    text-decoration: none;

    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .workshop-link:hover {
    text-decoration: none;
    box-shadow: 0 5px 0 var(--color-deep-plum);
    transform: translateY(-2px);
  }

  .workshop-link:focus-visible {
    outline: 3px solid white;
    outline-offset: 4px;
  }

  /* TEAM */
  .team-sektion {
    max-width: 1512px;
    margin-inline: auto;
    padding: 48px 32px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  /* DESKTOP */
  @media (min-width: 1024px) {
    .book_udstyr_flex,
    .book_studio_flex {
      margin-top: -70px;
    }
  }

  /* MOBIL */
  @media (max-width: 700px) {
    .book_udstyr_flex,
    .book_studio_flex {
      display: grid;
      gap: 12px;
      padding-inline: 12px;
    }

    .book_udstyr_flex {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .book_studio_flex {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 24px;
    }

    .workshops-indhold {
      padding: 32px 24px;
    }

    .workshops-grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .workshop-card {
      box-sizing: border-box;
      width: 100%;
      max-width: 326px;
    }

    .projekter-indhold {
      grid-template-columns: 1fr;
    }

    .projekter-billeder {
      grid-template-columns: 1fr;
      grid-template-rows: auto;

      aspect-ratio: auto;
      justify-items: center;
      align-content: center;
      gap: 20px;
    }

    .projekt-video,
    .projekt-billede {
      grid-column: 1;
      grid-row: auto;

      width: 100%;
      max-width: 420px;
      height: auto;
      aspect-ratio: 16 / 9;

      transform: none;
    }

    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>