import Layout from "../layouts/layout.astro";
import OverskriftBookUdstyr from "../components/Overskrift_BookUdstyr.astro";
import Forside from "../components/Forside.astro";



const apiurl = "https://uyxpjeeivebwemzealvq.supabase.co/rest/v1/";
const equipmentTableName = "equipment";
const staffTableName = "staff";
const eventsTableName = "events";
const studiocardsTableName = "studiocards";


const key = "sb_publishable_2crJgmsXwxJPMYeBofiiEQ_Yrl1mHLo"

const options = {
	headers: {
		apikey: key
	},
}



const studiocardsResponse = await fetch(apiurl + studiocardsTableName, options); 
const studiocardsData =  await studiocardsResponse.json();

console.log("studiocardsData", studiocardsData);

const eventsResponse = await fetch(apiurl + eventsTableName, options); 
const eventsData =  await eventsResponse.json();

console.log("eventsData", eventsData);



const equipmentResponse = await fetch(apiurl + equipmentTableName, options); 
const equipmentData =  await equipmentResponse.json();

console.log("equipmentData", equipmentData);



const staffResponse = await fetch(apiurl + staffTableName, options); 
const staffData =  await staffResponse.json();

console.log("staffData", staffData);
