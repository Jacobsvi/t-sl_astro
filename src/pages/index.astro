<style>
  /* Hold hver sektions lag samlet */
  .udstyr-sektion,
  .studio-sektion {
    position: relative;
    isolation: isolate;
  }

  /* Begge grupper af cards */
  .book_udstyr_flex,
  .book_studio_flex {
    display: flex;
    gap: 30px;
    justify-content: center;

    /* Placér hele card-gruppen foran overskriften */
    position: relative;
    z-index: 1;

    margin-top: -40px;
    padding-inline: 28px;
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .book_udstyr_flex,
    .book_studio_flex {
      margin-top: -70px;
    }
  }

 /* Mobil */
@media (max-width: 1023px) {
  /* Fælles mobilindstillinger */
  .book_udstyr_flex,
  .book_studio_flex {
    display: grid;
    gap: 12px;
    padding-inline: 12px;
  }

  /* Udstyr: to cards pr. række */
  .book_udstyr_flex {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* Studio: ét card pr. række */
  .book_studio_flex {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 24px;
  }
}
</style>