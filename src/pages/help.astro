---
import Layout from "../layouts/layout.astro";
import StudioCard from "../components/help_card.astro";
---

<Layout>
  <main class="help-side">

    <StudioCard>
      <Fragment slot="banner-light">Hjælp og </Fragment>
      <Fragment slot="banner-bold">vejledning</Fragment>

      <img slot="photo" class="card-foto" src="/img/podcast.jpg" alt="To personer optager podcast med mikrofoner" />

      <Fragment slot="heading-light">Find den rigtige person </Fragment>
      <Fragment slot="heading-bold">der kan hjælpe dig</Fragment>

      <Fragment slot="text-1">
        Har du brug for hjælp til vejledning i udstyr, studios eller andre skære spørgsmål, så kom gerne ned til os. Vi har alle viden inden for alle studios og alt udstyr - nogen er dog mere specialiseret end andre.
      </Fragment>
      <Fragment slot="text-2">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit.<br />
        Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </Fragment>
    </StudioCard>

    <!-- Podcast -->
    <StudioCard>
      <Fragment slot="banner-light">Få hjælp til </Fragment>
      <Fragment slot="banner-bold">Podcast</Fragment>

      <img slot="photo" class="card-foto" src="/frederick.jpg" alt="Frederick, podcast specialist" />

      <Fragment slot="heading-light">Podcast specialist </Fragment>
      <Fragment slot="heading-bold">Frederick</Fragment>

      <Fragment slot="text-1">
        Skriv til frederick ved spørgsmål ang. Podcast.<br />
        Du er også velkommen til at komme ned og snakke med os.
      </Fragment>
      <Fragment slot="text-2">
        Tlf. 46 46 04 42<br />
        E-Mail: techandstorylab@ek.dk
      </Fragment>
    </StudioCard>

    <!-- Kamera -->
    <StudioCard>
      <Fragment slot="banner-light">Få hjælp til </Fragment>
      <Fragment slot="banner-bold">Kamera</Fragment>

      <img slot="photo" class="card-foto card-foto--illustration" src="/img/detektiv.png" alt="Illustration af detektiv med forstørrelsesglas" />

      <Fragment slot="heading-light">Kamera specialist </Fragment>
      <Fragment slot="heading-bold">Mikki</Fragment>

      <Fragment slot="text-1">
        Skriv til frederick ved spørgsmål ang. Kamera.<br />
        Du er også velkommen til at komme ned og snakke med os.
      </Fragment>
      <Fragment slot="text-2">
        Tlf. 46 46 04 42<br />
        E-Mail: techandstorylab@ek.dk
      </Fragment>
    </StudioCard>

    <!-- xyz 1 -->
    <StudioCard>
      <Fragment slot="banner-light">Få hjælp til </Fragment>
      <Fragment slot="banner-bold">xyz</Fragment>

      <img slot="photo" class="card-foto card-foto--illustration" src="/img/detektiv.png" alt="Illustration af detektiv med forstørrelsesglas" />

      <Fragment slot="heading-light">xxxx specialist </Fragment>
      <Fragment slot="heading-bold">Frederick</Fragment>

      <Fragment slot="text-1">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit.<br />
        Du er også velkommen til at komme ned og snakke med os.
      </Fragment>
      <Fragment slot="text-2">
        Tlf. 46 46 04 42<br />
        E-Mail: techandstorylab@ek.dk
      </Fragment>
    </StudioCard>

    <!-- xyz 2 -->
    <StudioCard>
      <Fragment slot="banner-light">Få hjælp til </Fragment>
      <Fragment slot="banner-bold">xyz</Fragment>

      <img slot="photo" class="card-foto card-foto--illustration" src="/img/detektiv.png" alt="Illustration af detektiv med forstørrelsesglas" />

      <Fragment slot="heading-light">xxxx specialist </Fragment>
      <Fragment slot="heading-bold">Frederick</Fragment>

      <Fragment slot="text-1">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit.<br />
        Du er også velkommen til at komme ned og snakke med os.
      </Fragment>
      <Fragment slot="text-2">
        Tlf. 46 46 04 42<br />
        E-Mail: techandstorylab@ek.dk
      </Fragment>
    </StudioCard>

  </main>
</Layout>

<style>
  /* ---------- MOBIL (standard) ---------- */
  .help-side {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 24px 16px 48px;
  }

  /* Billeder der sendes ind i photo-sloten */
  .card-foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 11px;
  }

  /* Illustrationer skal ikke beskæres */
  .card-foto--illustration {
    object-fit: contain;
  }

  /* ---------- TABLET / DESKTOP ---------- */
  @media (min-width: 768px) {
    .help-side {
      align-items: center;
      gap: 48px;
      padding: 48px 32px 64px;
    }
  }
</style>