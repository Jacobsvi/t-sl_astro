---
import KnapSecondary from "./Knap_secondary.astro";

interface Props {
  type: string | null;
  brand: string | null;
  description: string | null;
  image: string | null;
}

const { type, brand, description, image } = Astro.props;
---

<article class="card">
  <div class="card_billede">
    {
      image ? (
        <img
          src={image}
          alt={`${brand ?? ""} ${type ?? ""}`.trim() || "Udstyr"}
          loading="lazy"
        />
      ) : (
        <div class="intet_billede">Intet billede</div>
      )
    }
  </div>

  <div class="card_tekst">
    <h2>{brand}</h2>
    <h3>{type}</h3>
    <p>{description}</p>
  </div>

  <div class="card_knap">
    <KnapSecondary>Book Udstyr</KnapSecondary>
  </div>
</article>

<style>
  /* CARD */
  .card {
    display: flex;
    flex-direction: column;

    width: 100%;
    min-width: 0;
    box-sizing: border-box;

    background-color: var(--color-deep-plum);
    color: var(--color-pure-white);

    border: 4px solid var(--color-deep-plum);
    border-radius: 24px;
    overflow: hidden;
  }

  /* BILLEDE */
  .card_billede {
    aspect-ratio: 4 / 3;
    flex-shrink: 0;
    border-radius: 18px;
    overflow: hidden;
  }

  .card_billede img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intet_billede {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    background-color: #eeeeee;
    color: #333333;
    font-size: 14px;
  }

  /* TEKST */
  .card_tekst {
    padding: 12px;
    overflow-wrap: anywhere;
  }

  .card_tekst h2 {
    margin: 0 0 6px;
    font-size: 22px;
    line-height: 1.2;
  }

  .card_tekst h3 {
    margin: 0 0 10px;
    font-size: 16px;
    line-height: 1.3;
  }

  .card_tekst p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  /* KNAP */
  .card_knap {
    display: flex;
    justify-content: center;

    margin-top: auto;
    padding: 16px 8px;
  }

  /* DESKTOP */
  @media (min-width: 1024px) {
    .card_tekst {
      padding: 20px;
    }

    .card_tekst h2 {
      font-size: 28px;
    }

    .card_tekst h3 {
      font-size: 18px;
    }

    .card_tekst p {
      font-size: 16px;
    }

    .card_knap {
      padding: 20px 12px;
    }
  }
</style>