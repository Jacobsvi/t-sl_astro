---

import logo from "../images/TogSL_logo.png";

const { logoSrc = logo.src } = Astro.props;


const labLinks = [
  { text: "Instagram", href: "https://www.instagram.com/erhvervsakademikoebenhavn_labs/" },
  { text: "Vejledning", href: "/help" },
  { text: "Booking", href: "/udstyr" },
  { text: "Events & workshops", href: "/events" },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <a
      class="footer-logo-link"
      href="/"
      aria-label="Tech & Story Lab – forside"
    >
      {
        logoSrc ? (
          <img
            class="footer-logo"
            src={logoSrc}
            alt="Tech & Story Lab"
            width="256"
            height="256"
          />
        ) : (
          <span class="footer-logo-placeholder" aria-hidden="true">
            Tech &amp;
            <br />
            Story Lab
          </span>
        )
      }
    </a>

    <nav class="footer-group" aria-labelledby="footer-ek-title">
      <h2 id="footer-ek-title" class="footer-heading">Information</h2>
      <ul class="footer-links">
      <li>
  <h3 class="footer-info-title">Adresse:</h3>
  <p class="footer-info-text">
    EK Guldbergsgade, Bygning A, A025
    <br />
    (lokalet bag receptionen)
  </p>
</li>

<li>
  <h3 class="footer-info-title">Åbningstider:</h3>
  <p class="footer-info-text">
    Mandag til torsdag kl. 09:00–16:00
    <br />
    Fredag kl. 09:00–15:00
  </p>
</li>

<li>
  <h3 class="footer-info-title">Adgang til labbet og vilkår for brug:</h3>
  <p class="footer-info-text footer-terms">
    Tech &amp; Story Lab er åbent for alle studerende, undervisere
    og øvrige ansatte på EK. Studier og faciliteter i EK's labs
    må udelukkende anvendes til prototypeudvikling, øvelse og
    eksperimenter og ikke til kommerciel produktion eller anden
    erhvervsmæssig drift.
  </p>
</li>

<li>
  <h3 class="footer-info-title">Kontakt:</h3>
  <p class="footer-info-text">
    Telefon: 46 46 04 42
    <br />
    E-mail: techandstorylab@ek.dk
  </p>
</li>
      </ul>
    </nav>

    <nav class="footer-group" aria-labelledby="footer-lab-title">
      <h2 id="footer-lab-title" class="footer-heading">Tech and Story Lab</h2>
      <ul class="footer-links">
        {
          labLinks.map((link) => (
            <li><a href={link.href}>{link.text}</a></li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    --footer-background: var(--color-deep-plum);
    --footer-accent: var(--color-soft-pink);
    width: 100%;
    background-color: var(--footer-background);
    color: var(--color-pure-white);
    font-family: inherit;
  }

  .site-footer,
  .site-footer * {
    box-sizing: border-box;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1.5fr);
    align-items: start;
    gap: clamp(32px, 6.6vw, 100px);
    width: 100%;
    max-width: 1512px;
    margin-inline: auto;
    padding: 28px clamp(24px, 8.5vw, 128px);
  }

  .footer-logo-link {
    display: block;
    width: 100%;
    max-width: 256px;
    border-radius: 50%;
    color: -- var(--color-pure-white);
    text-decoration: none;
  }

  .footer-logo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }
/** 
  .footer-logo-placeholder {
    display: grid;
    place-content: center;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: rgb(255 141 157 / 12%);
    font-family: var(--font-oso-serif);
    font-size: clamp(24px, 2.7vw, 40px);
    font-style: italic;
    text-align: center;
  } ****/

  .footer-group {
    min-width: 0;
    padding-top: 14px;
  }

  .footer-heading {
    margin: 0 0 12px;
    padding: 8px 16px;
    border-radius: 12px;
    background-color: var(--footer-accent);
    color: var(--footer-background);
    font-family: var(--font-oso-serif);
    font-size: 18px;
    font-style: italic;
    font-weight: 400;
    text-align: center;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0 10px;
    list-style: none;
  }

  .footer-links a {
    display: inline-block;
    padding-block: 4px;
    color: var(--color-pure-white);
    font-size: 12px;
    font-weight: 400;
    text-decoration: none;
    overflow-wrap: anywhere;
    font-family: var(--font-oso-sans);
  }

  .footer-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-links a:focus-visible,
  .footer-logo-link:focus-visible {
    outline: 3px solid white;
    outline-offset: 5px;
  }

  .footer-info-title {
  margin: 0;
  font-family: var(--font-oso-sans);
  font-size: 12px;
  font-weight: 700;
}

.footer-info-text {
  margin: 4px 0 0;
  font-family: var(--font-oso-sans);
  font-size: 12px;
  font-weight: 400;
  overflow-wrap: anywhere;
}

.footer-terms {
  font-size: 8px;
  font-style: italic;
}

  @media (max-width: 700px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 32px 24px;
    }

    .footer-logo-link {
      max-width: 150px;
      justify-self: center;
    }

    .footer-logo-placeholder {
      font-size: 20px;
    }

    .footer-group {
      padding-top: 0;
    }

    .footer-links a {
      font-size: 10px;
    }
  }
</style>
