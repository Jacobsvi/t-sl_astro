---
const {
  billede,
  navn,
  titel,
  speciale = "",
  telefon = "",
  email = "",
} = Astro.props;
---

<article class="team-card">
  <div class="team-person">
    {
      billede && (
        <img
          class="team-billede"
          src={billede}
          alt={`Portræt af ${navn}`}
        />
      )
    }

    <p class="team-navn"> {navn}</p>
  </div>

  <div class="team-info">
    <h3>{titel}</h3>

    <p class="team-speciale">{speciale}</p>

    <address class="team-kontakt">
      {
        telefon && (
          <a href={`tel:${telefon.replace(/\s/g, "")}`}>
            Tlf.: {telefon}
          </a>
        )
      }

      {
        email && (
          <a href={`mailto:${email}`}>
            E-mail: {email}
          </a>
        )
      }
    </address>
  </div>
</article>

<style>
  .team-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;

    padding: 24px;
    background-color: var(--color-deep-plum);
    color: var(--color-pure-white);
    border-radius: 28px;
    box-shadow: 6px 8px 4px rgb(0 0 0 / 25%);
  }

  .team-person,
  .team-info {
    min-width: 0;
  }

  .team-billede {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 10.8;
  object-fit: cover;
  border-radius: 20px;
}

  .team-navn {
    font: var(--broedtekst-stor-oso-sans);
    font-weight: 600;
    color: var(--color-soft-pink);
    margin: 8px 0 0;
    overflow-wrap: anywhere;
  }

  .team-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .team-info h3 {
    font: var(--h1-oso-serif);
    margin: 0 0 12px;
    overflow-wrap: anywhere;
  }

  .team-speciale {
    font: var(--broedtekst-oso-sans);
    margin: 0 0 32px;
  }

  .team-kontakt {
    display: flex;
    flex-direction: column;
    gap: 8px;

    margin-top: auto;
    font: var(--broedtekst-lille-oso-sans);
  }

  .team-kontakt a {
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .team-kontakt a:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .team-card {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>