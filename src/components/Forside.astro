---
import KnapPrimary from "./Knap_primary.astro";

import Photo from "../images/Photo.png";
---



	<div class="forside_1_1">
<div class="venstre_side">
	<h1>Plads til dine ideer</h1>
	<h3>Lån udstyr, book studio og få hjælp til dit næste projekt </h3>

	<div class="knapper_forside">
<KnapPrimary href="/udstyr/">Udstyr</KnapPrimary>
<KnapPrimary href="/udstyr/">Book Studio</KnapPrimary>
	<KnapPrimary href="/inspiration/">Events / Workshops</KnapPrimary>
	<KnapPrimary href="/help/">Vejledning</KnapPrimary>
</div>
</div>
<div class="højre_side">
<img slot="billede" src={Photo.src} alt="Photo"/>
</div>
</div>






<style>

.forside_1_1 {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 40px;

      max-width: 1320px;
      margin-inline: auto;
      padding: 16px 24px;
      box-sizing: border-box;
       align-items: stretch;
    }

.venstre_side h1 {
      margin-top: 70px;
margin-bottom: 20px;
      font-family: var(--font-oso-serif);
      font-weight: 400;
      font-style: italic;

      font-size: 30px;
      color: #000000;
    }


    /* Kun knappernes placering i desktop og mobile */
 .knapper_forside {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: 1fr;
  gap: 20px;
  margin-top: auto;
}

  /* DESKTOP */
  @media (min-width: 1000px) {
    /* To kolonner: tekst og billede */
    .forside_1_1 {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 40px;

      max-width: 1320px;
      margin-inline: auto;
      padding: 16px 24px;
      box-sizing: border-box;
       align-items: stretch;
    }

    /* Venstre kolonne */
    .venstre_side {
      display: flex;
      flex-direction: column;
      min-width: 0;
      padding-bottom: 0;
    }

    /* Overskrift */
    .venstre_side h1 {
      margin-top: 70px;
margin-bottom: 20px;
      font-family: var(--font-oso-serif);
      font-weight: 400;
      font-style: italic;

      font-size: 80px;
      color: #000000;
    }

    /* Beskrivelse */
    .venstre_side h3 {

      margin: 10px 0 100px;
      font-weight: 400;
      font-size: 20px;
    }


    /* Højre kolonne */
    .højre_side {
      min-width: 0;
      aspect-ratio: 1.12;
      border-radius: 18px;
      overflow: hidden;
    }

    .højre_side img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }


 @media (max-width: 1000px) {
  .forside_1_1 {
    grid-template-columns: 1fr;
    grid-template-areas:
      "titel"
      "billede"
      "beskrivelse"
      "knapper";
    gap: 24px;
  }

  .venstre_side {
    display: contents;
  }

  .venstre_side h1 {
    grid-area: titel;
    margin: 0;
  }

  .højre_side {
    grid-area: billede;
    border-radius: 18px;
    overflow: hidden;
  }

  .højre_side img {
    display: block;
    width: 100%;
    height: auto;
  }

  .venstre_side h3 {
    grid-area: beskrivelse;
    margin: 0;
  }

  .knapper_forside {
    grid-area: knapper;
    grid-template-columns: 1fr;
  }
}
}
</style>

