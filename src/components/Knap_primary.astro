---
import "../styles/global_styles.css";

const { href } = Astro.props;
---








<div class="yderste_frame">
    <div class="inderste_frame">
        <button class="knap">
          <a href={href} class="knap-primary">
   <slot/>
          </a>
        </button>
    </div>
</div>






<style>



.yderste_frame {
display: inline-block;
background-color: var(--color-deep-plum);
padding: 3px;
margin: 0%;
border-radius: 11px;
border-top-right-radius: 5px;
box-shadow: 0 3px 0 #aaaaaa;
}



.inderste_frame {
display: inline-block;
background-color: var(--color-soft-pink);
padding: 2px;

border-radius: 9px;
border-top-right-radius: 3px;
}




.knap{
background-color: var(--color-deep-plum);
color: var(  --color-pure-white);
border: 0px;

border-radius:7px;

width: clamp(104px, 17vw, 151px);
min-height: 29px;
height: auto;

padding: clamp(2px, 0.8vw, 4px) clamp(1px, 1.5vw, 2px);
font: var(--knap-oso-serif);
}


.yderste_frame:hover {
transform: scale(1.05);
}




@media (max-width: 1023px) {
  .knap {
    width: 120px;
    padding: 3px 10px;


        min-height: 15px;
  }
}
</style>







