---
import "../styles/global_styles.css";

const { href } = Astro.props;
---








<div class="yderste_frame">
    <div class="inderste_frame">
       
<a href={href} class="knap">
     <slot/>
          </a>
    
    </div>
</div>






<style>


.knap {
 display: flex;
 justify-content: center;
 align-items: center;
 
 text-decoration: none;
 color: var( --color-pure-white);
 background-color: var( --color-deep-plum);
 padding: 10px;
 border-radius:7px;

   font: var(--knap-oso-serif);
}


.inderste_frame {
  background-color: var(--color-soft-pink);
  padding: 3px;

  border-radius: 9px;
border-top-right-radius: 3px;
}

.yderste_frame {
   background-color: var( --color-deep-plum);
    padding: 3px;
    border-radius: 13px;
    border-top-right-radius: 3px;
}


@media (max-width: 767px) {
  .yderste_frame,
  .inderste_frame,
  .knap {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: auto;
  }

  .knap {
    display: flex;
    align-items: center;
    justify-content: center;

    font: var(--knap-oso-serif);
    font-size: 16px;
    min-height: 44px;
    padding: 10px 12px;
    text-align: center;
  }
}

</style>







