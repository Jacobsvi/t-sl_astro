---
import "../styles/global_styles.css";

const { href = "/", compact = false } = Astro.props;
---

<a
  href={href}
  class:list={["knap-primary", { "knap-compact": compact }]}
>
  <slot />
</a>

<style>
  .knap-primary {
    display: flex;
    align-items: center;
    justify-content: center;

    box-sizing: border-box;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 64px;
    padding: 8px 12px;

    font: var(--knap-oso-serif);
    color: var(--color-pure-white);
    text-decoration: none;
    text-align: center;
    overflow-wrap: anywhere;

    background-color: var(--color-deep-plum);
    border: 3px solid var(--color-deep-plum);
    border-radius: 11px;
    border-top-right-radius: 5px;

    box-shadow:
      inset 0 0 0 2px var(--color-soft-pink),
      0 3px 0 #aaaaaa;

    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .knap-primary.knap-compact {
  width: 170px;
  height: 44px;
  min-height: 44px;
  padding: 6px 12px;
}
  .knap-primary:visited {
    color: var(--color-pure-white);
  }

  .knap-primary:hover {
    box-shadow:
      inset 0 0 0 2px var(--color-soft-pink),
      0 5px 0 #aaaaaa;
    transform: translateY(-2px);
  }

  .knap-primary:focus-visible {
    outline: 3px solid var(--color-soft-pink);
    outline-offset: 3px;
  }
</style>