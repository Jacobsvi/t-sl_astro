---
import "../styles/global_styles.css";
---








<div class="yderste_frame">
    <div class="inderste_frame">
        <button class="knap">
            <slot/>
        </button>
    </div>
</div>






<style>



.yderste_frame {
display: inline-block;
background-color: #FFB34A;
padding: 3px;
margin: 0%;
border-radius: 11px;
border-top-right-radius: 5px;
box-shadow: 0 3px 0 #aaaaaa;
}



.inderste_frame {
display: inline-block;
background-color: white;
padding: 2px;

border-radius: 9px;
border-top-right-radius: 3px;
}




.knap{
background-color: #FFB34A;
color: white;
border: 0px;

border-radius:7px;

width: clamp(104px, 17vw, 151px);
height: clamp(23px, 4vw, 29px);

padding: clamp(2px, 0.8vw, 4px) clamp(1px, 1.5vw, 2px);
/* font-family: Georgia, serif;
font-size: clamp(0rem, 0.5rem + 0.5vw, 1.25rem);
font-style: italic; */



  font-family: var(--button-font-family);
  font-style: var(--button-font-style);
  font-size: var(--button-size);
  line-height: var(--button-line-height);
  letter-spacing: var(--button-letter-spacing);

}



.yderste_frame:hover {
transform: scale(1.05);
}




@media (max-width: 1023px) {
  .knap {
    width: 74px;
    padding: 3px 10px;

    font-size: 10px;
    line-height: 20px;

        min-height: 15px;
  }
}
</style>

