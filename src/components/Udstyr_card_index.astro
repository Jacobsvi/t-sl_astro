---
import KnapSecondary from "./Knap_secondary.astro";




---









<article class="card">
    <slot/>
  <div class="card-indhold">
      
        <div class="card-tekst">
      <slot name="tekst" />
 </div>

    <div class="card-knap">
   <KnapSecondary>Book Udstyr</KnapSecondary>
    </div>
  </div>
</article>













<style>

 .card {
    width: 100%;
    max-width: 395px;
    box-sizing: border-box;
    padding: 8px;

    background-color: #78003f;
    color: white;
    border-radius: 26px;
    box-shadow: 6px 8px 4px #00000040;
  }

  .card :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
  }

 .card-indhold {
  padding-top: 0px;
  padding-right: 0px;
  padding-bottom: 18px;
  padding-left: 0px;
}

  .card-indhold h2 {
    margin: 0 0 8px;
    font-family: Georgia, serif;
    font-size: 46px;
    font-style: italic;
    font-weight: normal;
  }

  /* Beskrivelse */
  .card-indhold p {
    margin: 0;
    font-family: Arial, sans-serif;
    font-size: 18px;
    line-height: 1.6;
  }
  

    .card-knap {
    display: flex;
    justify-content: center;
    margin-top: 60px;
  }

.card-tekst {
  padding: 0 14px;
}
