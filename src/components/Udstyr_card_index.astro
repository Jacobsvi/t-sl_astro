---
import KnapSecondary from "./Knap_secondary.astro";




---









<article class="card">
  
  <div class="card_billede">
<slot name="billede" />
  </div>



  <div class="card_tekst">
<slot name="tekst" />
  </div>



  <div class="card_knap">
<KnapSecondary>Book Udstyr</KnapSecondary>
  </div>

</article>













<style>

.card {
display: flex;
flex-direction: column;
min-width: 0;
max-width: 300px;

background-color: var( --color-deep-plum);
color: var(  --color-pure-white);
border-radius: 24px;

overflow: hidden;

border: solid 8px var(--color-deep-plum);
}



.card_billede {
height: 250px;
flex-shrink: 0;
}

.card_billede :global(img) {
display: block;
width: 100%;
height: 100%;
object-fit: cover;

border-radius: 18px;
}


.card_tekst {
  padding: 20px 20px;
  overflow-wrap: anywhere;
}


.card-tekst :global(h2) {
    margin: 0 0 12px;
  }

  .card-tekst :global(p) {
    margin: 0;
  }


  .card_knap {
    margin-top: auto;
    display: flex;
    justify-content: center;
    padding: 20px 16px 28px;
  }







