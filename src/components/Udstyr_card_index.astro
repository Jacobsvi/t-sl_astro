---
import KnapSecondary from "./Knap_secondary.astro";




---

<article class="card">
  
  <div class="card_billede">
<slot name="billede" />
  </div>



  <div class="card_tekst">
<slot name="tekst" />
  </div>



  <div class="card_knap">
<KnapSecondary>Book Udstyr</KnapSecondary>
  </div>

</article>





<style>
  /* CARD — FÆLLES DESIGN */
  .card {
    display: flex;
    flex-direction: column;

    width: 100%;
    max-width: 300px;
    min-width: 0;
    box-sizing: border-box;

    background-color: var(--color-deep-plum);
    color: var(--color-pure-white);

    border: 4px solid var(--color-deep-plum);
    border-radius: 24px;
    overflow: hidden;
  }

  /* BILLEDE */
  .card_billede {
    aspect-ratio: 4 / 3;
    flex-shrink: 0;
    border-radius: 18px;
    overflow: hidden;
  }

  .card_billede :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* TEKST — MOBIL */
  .card_tekst {
    padding: 10px;
    overflow-wrap: break-word;
  }

  .card_tekst :global(h2) {
    margin: 0 0 3px;
    font-size: 22px;
    line-height: 36px;
  }

  .card_tekst :global(p) {
    margin: 0;
    font-size: 10px;
    line-height: 14px;
  }

  /* KNAP */
  .card_knap {
    margin-top: auto;
    display: flex;
    justify-content: center;
    padding: 20px 8px 10px;
  }

  /* TEKST OG AFSTANDE — DESKTOP */
  @media (min-width: 1024px) {
    .card_tekst {
      padding: 24px;
    }

    .card_tekst :global(h2) {
      font-size: 40px;
      line-height: 44px;
    }

    .card_tekst :global(p) {
      font-size: 18px;
      line-height: 28px;
    }

    .card_knap {
      padding: 24px 8px 28px;
    }
  }
</style>




